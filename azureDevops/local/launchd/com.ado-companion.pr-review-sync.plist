<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh --with-review-sync fills in __NODE__ and __HOME__ and writes this to
     ~/Library/LaunchAgents. Runs at 18:00, or at the next wake after a missed run. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ado-companion.pr-review-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__HOME__/.local/bin/pr-review-sync</string>
    <string>--run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>18</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.local/share/pr-review/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/share/pr-review/launchd.log</string>
</dict>
</plist>
