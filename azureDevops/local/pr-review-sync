#!/usr/bin/env node
/**
 * Copies the PR review clock's logged reviews into the Judgment Log.
 *
 * The ADO Toolbox's review clock logs reviews through ado-companion into
 * REVIEW_LOG (one event per line). The Judgment Log artifact keeps them in its
 * own collection, prtime/w<Monday>: {week, sessions}, one doc per week, each
 * overwritten whole from the log, so edits and deletes in the log carry over.
 * (The log's hand-tracked time lives in time/w<Monday>, which this never touches.)
 *
 * Only a background Claude session can write that database (`claude -p` has no
 * ArtifactData), so --run starts one allowed only ToolSearch and ArtifactData,
 * waits for its "<batch> written" reply, then stops and deletes it. Nothing changed:
 * no session is started.
 *
 *   pr-review-sync --run      what launchd runs nightly
 *   pr-review-sync --pending  print the weeks that would be written, write nothing
 *
 * Settings, in ado-companion's ~/.config/ado-companion/config.json:
 *   judgmentLogUrl   the Judgment Log artifact (required for --run)
 *   claudeConfigDir  the Claude profile the session runs in (default ~/.claude)
 */
import { execFile } from 'node:child_process'
import { createHash } from 'node:crypto'
import { appendFileSync, existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { join } from 'node:path'
import { promisify } from 'node:util'

const run = promisify(execFile)
const DIR = join(homedir(), '.local/share/pr-review')
const REVIEW_LOG = join(DIR, 'sessions.jsonl')
const SYNCED = join(DIR, 'synced.json')
const OUT = join(DIR, 'out')
const SYNC_LOG = join(DIR, 'sync.log')
const SETTINGS_FILE = process.env.ADO_COMPANION_CONFIG || join(homedir(), '.config/ado-companion/config.json')
const settings = (() => {
  try {
    return JSON.parse(readFileSync(SETTINGS_FILE, 'utf8'))
  } catch {
    return {}
  }
})()
const expandHome = (p) => (typeof p === 'string' ? p.replace(/^~(?=\/|$)/, homedir()) : '')
const JUDGMENT_LOG = typeof settings.judgmentLogUrl === 'string' ? settings.judgmentLogUrl : ''
const CLAUDE = join(homedir(), '.local/bin/claude')
const CONFIG = expandHome(settings.claudeConfigDir) || join(homedir(), '.claude')
// The default profile keeps state in ~/.claude.json, which an explicit CLAUDE_CONFIG_DIR would skip.
const CLAUDE_ENV = { ...process.env }
if (CONFIG === join(homedir(), '.claude')) delete CLAUDE_ENV.CLAUDE_CONFIG_DIR
else CLAUDE_ENV.CLAUDE_CONFIG_DIR = CONFIG
const MAX_WEEKS = 50 // one ArtifactData batch
const WAIT_MS = 8 * 60 * 1000

const log = (msg) => {
  mkdirSync(DIR, { recursive: true })
  appendFileSync(SYNC_LOG, `${new Date().toISOString()} ${msg}\n`)
}

// A background session's transcript, found through its job record.
function transcriptOf(id) {
  const sessionId = readJson(join(CONFIG, 'jobs', id, 'state.json'), {}).sessionId
  if (!sessionId) return null
  const file = join(CONFIG, 'projects', DIR.replace(/[^A-Za-z0-9]/g, '-'), `${sessionId}.jsonl`)
  return existsSync(file) ? file : null
}

// Everything the session itself said (assistant text), not the prompt.
function replies(file) {
  let text = ''
  try {
    text = readFileSync(file, 'utf8')
  } catch {
    return ''
  }
  const said = []
  for (const line of text.split('\n')) {
    try {
      const e = JSON.parse(line)
      if (e.type !== 'assistant') continue
      for (const part of e.message?.content || []) if (part.type === 'text') said.push(part.text)
    } catch {
      /* a partly written line */
    }
  }
  return said.join('\n')
}

// The log folded to its current sessions (a later put of an id replaces it).
function sessions() {
  let text = ''
  try {
    text = readFileSync(REVIEW_LOG, 'utf8')
  } catch {
    return []
  }
  const byId = new Map()
  for (const line of text.split('\n')) {
    if (!line) continue
    try {
      const e = JSON.parse(line)
      if (e.op === 'put' && e.session?.id) byId.set(e.session.id, e.session)
      else if (e.op === 'delete' && e.id) byId.delete(e.id)
    } catch {
      /* a torn line */
    }
  }
  return [...byId.values()]
}

// The Monday (local time) of the week a moment falls in, as the Judgment Log
// keys its weeks: YYYY-MM-DD.
function weekOf(ms) {
  const d = new Date(ms)
  d.setHours(12, 0, 0, 0)
  d.setDate(d.getDate() - ((d.getDay() + 6) % 7))
  const pad = (n) => String(n).padStart(2, '0')
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
}

const readJson = (file, fallback) => {
  try {
    return JSON.parse(readFileSync(file, 'utf8'))
  } catch {
    return fallback
  }
}
const hash = (doc) => createHash('sha256').update(JSON.stringify(doc)).digest('hex').slice(0, 16)

// Weeks whose doc differs from what was last synced, a week emptied by deletes
// included (its doc is rewritten with no sessions).
function pending() {
  const synced = readJson(SYNCED, { weeks: {} }).weeks
  const byWeek = {}
  for (const s of sessions()) (byWeek[weekOf(s.start)] ||= []).push(s)
  for (const week of Object.keys(synced)) byWeek[week] ||= []
  return Object.entries(byWeek)
    .map(([week, list]) => {
      const doc = { week, sessions: list.sort((a, b) => a.start - b.start) }
      return { week, doc, hash: hash(doc) }
    })
    .filter((w) => synced[w.week] !== w.hash)
    .sort((a, b) => b.week.localeCompare(a.week))
    .slice(0, MAX_WEEKS)
}

async function runSync() {
  if (!/^https:\/\/claude\.ai\/artifact\/[A-Za-z0-9]+$/.test(JUDGMENT_LOG)) return log(`no judgmentLogUrl in ${SETTINGS_FILE}`)
  const weeks = pending()
  if (!weeks.length) return log('nothing to sync')
  mkdirSync(OUT, { recursive: true })
  const batch = `b${Date.now()}`
  const lines = weeks.map(({ week, doc }) => {
    const file = join(OUT, `prtime-w${week}.json`)
    writeFileSync(file, JSON.stringify(doc))
    return `- doc_id w${week}, file_path ${file}`
  })
  const prompt = [
    "Copy PR review time into the Judgment Log's database. Use only ToolSearch (to load ArtifactData) and ArtifactData. Do nothing else and don't read the files.",
    `1. ArtifactData action "list", url ${JUDGMENT_LOG}, collection "prtime", query {"limit": 1000}. Note each document's id and version.`,
    `2. ArtifactData action "batch", url ${JUDGMENT_LOG}, writes: one {"op": "set", "collection": "prtime", "doc_id", "file_path"} entry per line below, with "if_version" set to that document's version from step 1 when it exists (leave if_version out for a new document):`,
    ...lines,
    `3. This sync's id is ${batch}. If the batch succeeded, reply with that id followed by the word "written". Otherwise reply with the id followed by the word "failed:" and the error.`,
  ].join('\n')

  // Background sessions start in the profile's permission mode (bypass, here).
  // Default mode with only these two allowed keeps it to them: anything else
  // waits for an approval nobody gives, and the wait below times out. (--tools
  // can't do it: it drops ArtifactData too.)
  const { stdout } = await run(CLAUDE, ['--bg', '--model', 'haiku', '-n', 'Review time sync', '--permission-mode', 'default',
    '--allowedTools=ToolSearch,ArtifactData', prompt],
    { cwd: DIR, env: CLAUDE_ENV, timeout: 60000 })
  const id = /claude (?:attach|logs|stop) ([0-9a-f]{6,})/.exec(stdout)?.[1]
  if (!id) return log(`couldn't start a session: ${stdout.trim().slice(0, 300)}`)
  log(`${batch}: session ${id} writing ${weeks.map((w) => w.week).join(', ')}`)

  // The answer is read from the transcript's assistant messages: `claude logs` is
  // the raw terminal (cursor codes between words, and the prompt echoed back).
  let result = 'timed out'
  let transcript = null
  const deadline = Date.now() + WAIT_MS
  while (Date.now() < deadline) {
    await new Promise((r) => setTimeout(r, 10000))
    transcript ||= transcriptOf(id)
    if (!transcript && !existsSync(join(CONFIG, 'jobs', id)) && Date.now() > deadline - WAIT_MS + 60000) {
      result = 'the session disappeared'
      break
    }
    const said = transcript ? replies(transcript) : ''
    if (said.includes(`${batch} written`)) {
      result = 'ok'
      break
    }
    const failed = new RegExp(`${batch} failed:.*`).exec(said)
    if (failed) {
      result = failed[0].slice(0, 300)
      break
    }
  }
  // Stop first: rm refuses a running session. Never kill it; the daemon would resume it.
  await run(CLAUDE, ['stop', id], { env: CLAUDE_ENV, timeout: 30000 }).catch(() => {})
  await run(CLAUDE, ['rm', id], { env: CLAUDE_ENV, timeout: 30000 }).catch((e) => log(`couldn't remove session ${id}: ${e.message}`))
  // rm leaves the transcript; a nightly job shouldn't pile them up. Kept on failure.
  if (transcript && result === 'ok') rmSync(transcript, { force: true })

  if (result !== 'ok') return log(`${batch}: ${result}`)
  const synced = readJson(SYNCED, { weeks: {} })
  for (const w of weeks) synced.weeks[w.week] = w.hash
  writeFileSync(SYNCED, JSON.stringify(synced, null, 2))
  log(`${batch}: synced ${weeks.length} week(s)`)
}

const mode = process.argv[2]
if (mode === '--run') {
  runSync().catch((e) => {
    log(`failed: ${e.message}`)
    process.exitCode = 1
  })
} else if (mode === '--pending') {
  for (const w of pending()) console.log(`${w.week}\t${w.doc.sessions.length} session(s)`)
} else {
  console.error('usage: pr-review-sync --run | --pending')
  process.exitCode = 2
}
