#!/usr/bin/env bash
# cc-pr — find the local Claude Code sessions that worked on an Azure DevOps pull
# request and resume one. The Toolbox's "Resume locally" button hands the PR to it
# through a URL handler (see README); it also runs by hand:
#
#   cc-pr [--bg [--no-attach]] <pr-id> [source-branch]   pick a session (fzf), resume it here
#   cc-pr [--bg [--no-attach]] --open <transcript>       resume that session here
#   cc-pr --list <pr-id> [source-branch]   print the matches for another picker:
#                                          transcript, title, cwd, mtime, live (tab-separated)
#   cc-pr --thread-context <org> <project> <repo> <pr-id> <thread-id>
#                                          write a PR comment thread to a file for a session
#   cc-pr --start <name> <prompt>          start a new background session on a prompt
#
# --bg makes the session a background agent (`claude agents` lists it) and attaches
# this terminal to it, instead of a plain `claude --resume`. A session that is already
# running in the background is attached either way; one open in another terminal is
# left alone. --no-attach stops there and prints "<short id>\t<name>": the session
# runs in the background, to be opened from an agents view (← in an attached terminal
# opens one without the flags your own `claude agents` was started with, so sessions
# started there lose its permission mode).
#
# A session counts when Claude's own messages or the user's prompts mention the PR
# (its URL, "PR 123", "!123", pullRequests/123) or its source branch. Tool output,
# attachments and injected instructions don't count: a memory file or CLAUDE.md
# naming the PR would otherwise match every session. One match resumes straight
# away; several open an fzf picker, newest first. Needs rg, jq and fzf.
#
# Env:
#   CC_PR_PROJECTS  colon-separated transcript dirs (default: every ~/.claude*/projects)
#   CC_PR_CLAUDE    command that resumes (default: claude), e.g.
#                   "claude --dangerously-skip-permissions"
#   CC_PR_EXCLUDE_TITLE  sessions whose title matches this (extended regex, any case)
#                   are skipped; default: Claude Bridge's own sessions, "Teams: …",
#                   and sessions about it, "claude bridge …". Empty skips nothing.
#   CC_PR_START_DIR  where --start runs the new session (default: ~)
#   CC_PR_LIVE=0     --list leaves the live column empty (skips a `claude agents` call per match)
#   AZDO_PAT        Azure DevOps token for --thread-context (default: an `az` login)
#
# --thread-context prints "<file>\t<first comment, shortened>\t<PR title>\t<branch>";
# the file holds the PR, the thread's comments and what to do with them. --start
# reports the new session like --no-attach.
set -euo pipefail

usage() {
  sed -n '6,12p' "$0" | sed 's/^#   //' >&2
  exit 2
}

# The name `claude agents` shows: the agent name, else a /rename title, else the
# auto title (which can be stale).
title_of() {
  rg --no-filename '"type":"(agent-name|custom-title|ai-title)"' "$1" | jq -rs '
    def latest($t): map(select(.type == $t)) | last | .agentName // .customTitle // .aiTitle;
    [latest("agent-name"), latest("custom-title"), latest("ai-title")] | map(select(.)) | first // ""
    | gsub("\\s+"; " ")' 2>/dev/null || true
}

cwd_of() {
  rg -m1 --no-filename -o '"cwd":"[^"]*"' "$1" | cut -d'"' -f4 || true
}

# The profile dir a transcript belongs to: <config>/projects/<project>/<id>.jsonl
config_of() {
  dirname "$(dirname "$(dirname "$1")")"
}

# The default profile keeps its state in ~/.claude.json, which an explicit
# CLAUDE_CONFIG_DIR=~/.claude would skip.
use_config() {
  if [ "$1" = "$HOME/.claude" ]; then unset CLAUDE_CONFIG_DIR; else export CLAUDE_CONFIG_DIR=$1; fi
}

# "background <short id>", "interactive" or "" for a session id, from the live
# sessions of the profile already chosen with use_config.
live_state() {
  claude agents --json 2>/dev/null | jq -r --arg sid "$1" \
    'first(.[] | select(.sessionId == $sid) | if .kind == "background" then "background \(.id)" else .kind end) // ""' \
    2>/dev/null || true
}

bg=""
no_attach=""
mode=pick
while [ $# -gt 0 ]; do
  case $1 in
    --bg) bg=1; shift ;;
    --no-attach) bg=1; no_attach=1; shift ;;
    --list) mode=list; shift ;;
    --thread-context) mode=thread; shift; break ;;
    --start) mode=start; shift; break ;;
    --open) mode=open; open_file=${2:-}; shift 2 || usage ;;
    --preview)
      # fzf's preview pane
      f=$2
      echo "$(title_of "$f")"
      cwd=$(cwd_of "$f")
      echo "${cwd/#$HOME/~}   $(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$f")"
      echo
      echo "Recent prompts:"
      rg --no-filename '"type":"last-prompt","lastPrompt"' "$f" | jq -r '.lastPrompt | gsub("\\s+"; " ") | .[:300]' |
        uniq | tail -5 | sed 's/^/• /' || true
      exit 0
      ;;
    -*) usage ;;
    *) break ;;
  esac
done

if [ "$mode" = thread ]; then
  org=${1:-} project=${2:-} repo=${3:-} pr=${4:-} thread=${5:-}
  [[ $org =~ ^[A-Za-z0-9-]+$ && $project =~ ^[A-Za-z0-9._\ -]+$ && $repo =~ ^[A-Za-z0-9._-]+$ ]] || usage
  [[ $pr =~ ^[0-9]+$ && $thread =~ ^[0-9]+$ ]] || usage
  if [ -n "${AZDO_PAT:-}" ]; then
    auth="Basic $(printf ':%s' "$AZDO_PAT" | base64 | tr -d '\n')"
  else
    token=$(az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 \
      --query accessToken -o tsv 2>/dev/null) || { echo "cc-pr: no AZDO_PAT and no az login" >&2; exit 1; }
    auth="Bearer $token"
  fi
  project_path=$(jq -rn --arg p "$project" '$p | @uri')
  api="https://dev.azure.com/$org/$project_path/_apis/git/repositories/$repo/pullRequests/$pr"
  web="https://dev.azure.com/$org/$project_path/_git/$repo/pullrequest/$pr?discussionId=$thread"
  dir=${XDG_CACHE_HOME:-$HOME/.cache}/cc-pr
  mkdir -p "$dir"
  # The token goes to curl on stdin, not in its arguments where ps would show it.
  get() { printf 'Authorization: %s\n' "$auth" | curl -sf -H @- "$1"; }
  get "$api?api-version=7.1" >"$dir/.pr.json" || { echo "cc-pr: couldn't read PR $pr" >&2; exit 1; }
  get "$api/threads/$thread?api-version=7.1" >"$dir/.thread.json" ||
    { echo "cc-pr: couldn't read thread $thread on PR $pr" >&2; exit 1; }
  file="$dir/pr-$pr-thread-$thread.md"
  jq -rn --slurpfile pr "$dir/.pr.json" --slurpfile t "$dir/.thread.json" --arg web "$web" '
    $pr[0] as $p | $t[0] as $t | ($t.threadContext // {}) as $ctx
    | "# PR !\($p.pullRequestId): \($p.title)\n\n\($web)\n\n"
      + "Branch: \($p.sourceRefName | sub("^refs/heads/"; "")) into \($p.targetRefName | sub("^refs/heads/"; ""))\n"
      + (if $ctx.filePath then "Thread on \($ctx.filePath):\($ctx.rightFileStart.line // $ctx.leftFileStart.line // "?")"
         else "A general comment thread" end)
      + ", status \($t.status // "none")\n\n## Comments\n\n"
      + ([$t.comments[] | select(.commentType == "text" and (.isDeleted | not))
          | "**\(.author.displayName)**, \(.publishedDate[0:16] | sub("T"; " ")) UTC\n\n\(.content)\n"] | join("\n"))
      + "\n## What to do\n\nDo what this comment thread asks, on the PR source branch. Do not reply on the PR, "
      + "resolve the thread or change its status without asking me first: anything posted there posts as me. "
      + "When you are done, tell me what you did and suggest a reply.\n"' >"$file"
  summary=$(jq -r '[.comments[] | select(.commentType == "text" and (.isDeleted | not))][0]
    | "\(.author.displayName): \(.content | gsub("\\s+"; " ") | .[0:90])"' "$dir/.thread.json")
  printf '%s\t%s\t%s\t%s\n' "$file" "$summary" "$(jq -r .title "$dir/.pr.json")" \
    "$(jq -r '.sourceRefName | sub("^refs/heads/"; "")' "$dir/.pr.json")"
  rm -f "$dir/.pr.json" "$dir/.thread.json"
  exit 0
fi

if [ "$mode" = start ]; then
  name=${1:-} prompt=${2:-}
  [ -n "$name" ] && [ -n "$prompt" ] || usage
  cd "${CC_PR_START_DIR:-$HOME}"
  # shellcheck disable=SC2086 # CC_PR_CLAUDE is a command plus flags
  out=$(${CC_PR_CLAUDE:-claude} --bg -n "$name" "$prompt" 2>&1) || { echo "cc-pr: $out" >&2; exit 1; }
  short=$(printf '%s\n' "$out" | rg -o 'backgrounded · ([0-9a-f]+)' -r '$1' | head -1)
  [ -n "$short" ] || { echo "cc-pr: $out" >&2; exit 1; }
  echo "cc-pr: started in the background" >&2
  printf '%s\t%s\n' "$short" "$name"
  exit 0
fi

if [ "$mode" = open ]; then
  [ -f "$open_file" ] && [[ $open_file == *.jsonl ]] || { echo "cc-pr: no transcript at $open_file" >&2; exit 1; }
  pick=$open_file
else
  pr=${1:-}
  branch=${2:-}
  [[ $pr =~ ^[0-9]+$ ]] || usage
  [ -z "$branch" ] || [[ $branch =~ ^[A-Za-z0-9._/][A-Za-z0-9._/-]*$ ]] || usage

  roots=()
  if [ -n "${CC_PR_PROJECTS:-}" ]; then
    IFS=: read -r -a roots <<<"$CC_PR_PROJECTS"
  else
    for d in "$HOME"/.claude*/projects; do [ -d "$d" ] && roots+=("$d"); done
  fi
  [ ${#roots[@]} -gt 0 ] || { echo "cc-pr: no Claude transcript dirs found" >&2; exit 1; }

  # Oniguruma (jq) and Rust (rg) both read this; a branch only has [A-Za-z0-9._/-],
  # of which only "." needs escaping.
  re="pull ?requests?/$pr\\b|\\bPR[ #!]*$pr\\b|!$pr\\b"
  [ -z "$branch" ] || re="$re|${branch//./\\.}"
  exclude=${CC_PR_EXCLUDE_TITLE-^(Teams: |claude bridge)}

  # transcript, title, cwd, mtime, live — newest first
  rows=$(
    rg -l -i --no-messages -g '*.jsonl' -g '!subagents' -e "$re" "${roots[@]}" | while read -r f; do
      # Only Claude's text and tool calls, and prompts the user typed.
      hits=$( { rg -i --no-filename -e "$re" "$f" | jq -r --arg re "$re" '
        select(
          (.type == "assistant" and
            ([.message.content[]? | select(.type == "text" or .type == "tool_use") | tostring] | join(" ") | test($re; "i")))
          or (.type == "user" and (.isMeta | not) and
            ((.message.content | if type == "string" then . else [.[]? | select(.type == "text") | .text] | join(" ") end) | test($re; "i")))
        ) | 1' 2>/dev/null || true; } | wc -l | tr -d ' ')
      [ "$hits" -gt 0 ] || continue
      title=$(title_of "$f")
      if [ -n "$exclude" ] && printf '%s' "$title" | grep -Eiq -- "$exclude"; then continue; fi
      use_config "$(config_of "$f")"
      # CC_PR_LIVE=0 skips a `claude agents` call per match, for a caller that
      # reads the live sessions once itself.
      live=""
      [ "${CC_PR_LIVE-1}" = 0 ] || live=$(live_state "$(basename "$f" .jsonl)")
      printf '%s\t%s\t%s\t%s\t%s\n' "$f" "$title" "$(cwd_of "$f")" "$(stat -f %m "$f")" "${live%% *}"
    done | sort -t$'\t' -k4,4rn
  ) || true

  if [ "$mode" = list ]; then
    [ -z "$rows" ] || printf '%s\n' "$rows"
    exit 0
  fi
  if [ -z "$rows" ]; then
    echo "cc-pr: no local Claude session mentions PR $pr${branch:+ or $branch}"
    exit 1
  fi

  if [ "$(printf '%s\n' "$rows" | wc -l)" -eq 1 ]; then
    pick=${rows%%$'\t'*}
  else
    menu=$(printf '%s\n' "$rows" | while IFS=$'\t' read -r f title cwd mtime live; do
      printf '%s\t%s  %s  (%s)%s\n' "$f" "$(date -r "$mtime" '+%m-%d %H:%M')" "${title:-untitled}" \
        "${cwd/#$HOME/~}" "${live:+  · $live}"
    done)
    pick=$(printf '%s\n' "$menu" | fzf --delimiter='\t' --with-nth=2 --no-sort \
      --header="Claude sessions on PR $pr — Enter resumes" \
      --preview="$0 --preview {1}" --preview-window=down,40%,wrap) || exit 130
    pick=${pick%%$'\t'*}
  fi
fi

sid=$(basename "$pick" .jsonl)
short=${sid%%-*}
use_config "$(config_of "$pick")"
live=$(live_state "$sid")

# --no-attach reports the session as "<short id>\t<name in the agents list>".
report() {
  local name
  name=$(claude agents --json 2>/dev/null | jq -r --arg s "$sid" 'first(.[] | select(.sessionId == $s) | .name // "") // ""' 2>/dev/null || true)
  printf '%s\t%s\n' "$short" "$name"
}

case $live in
  background*)
    if [ -n "$no_attach" ]; then echo "cc-pr: already running in the background" >&2; report; exit 0; fi
    exec claude attach "${live#background }"
    ;;
  interactive) echo "cc-pr: that session is open in another terminal; switch to it there" >&2; exit 1 ;;
esac

# Sessions are stored per working directory, so resume from the one it ran in.
cwd=$(cwd_of "$pick")
if [ -n "$cwd" ] && [ -d "$cwd" ]; then cd "$cwd"; else echo "cc-pr: $cwd is gone; resuming from $PWD" >&2; fi

# A stopped background session (its job dir is named after the session id's first
# block) keeps its own saved options: attach reopens it, and --bg --resume without
# flags continues it, where flags would start a copy instead.
if [ -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/jobs/$short" ]; then
  [ -n "$no_attach" ] || exec claude attach "$short"
  claude --bg --resume "$sid" >/dev/null
  echo "cc-pr: continued in the background" >&2
  report
  exit 0
fi

if [ -n "$bg" ]; then
  # Named after its title, so the agents list (and its name search) shows it as the
  # picker did rather than by id.
  title=$(title_of "$pick")
  # shellcheck disable=SC2086 # CC_PR_CLAUDE is a command plus flags
  ${CC_PR_CLAUDE:-claude} --bg --resume "$sid" ${title:+-n "$title"} >/dev/null
  if [ -n "$no_attach" ]; then echo "cc-pr: resumed in the background" >&2; report; exit 0; fi
  exec claude attach "$short"
fi
# shellcheck disable=SC2086
exec ${CC_PR_CLAUDE:-claude} --resume "$sid"
